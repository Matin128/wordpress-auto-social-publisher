      "id": "c66bd5ea-31ee-4bdb-aa42-c611af992107",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "// ۱. دریافت متن خام خروجی LLM\nlet rawText = $input.item.json.text || \"\";\n\n// ۲. پاک‌سازی تگ‌های Markdown Codeblock\nrawText = rawText\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet aiData = {};\n\ntry {\n  aiData = JSON.parse(rawText);\n} catch (e) {\n  aiData = {\n    meta_description: \"خطا در تولید متای سئو\",\n    focus_keywords: \"خطا\",\n    telegram_post: \"خطا در پارس کردن خروجی هوش مصنوعی:\\n\" + rawText,\n    linkedin_post: \"\"\n  };\n}\n\n// ۳. دریافت لینک مقاله از وب‌هوک وردپرس\nconst postLink = $('Webhook').item.json.body.post?.permalink || '';\n\n// ۴. جایگزینی لینک و آماده‌سازی خروجی\nconst finalTelegram = (aiData.telegram_post || '').replace(/\\[لینک مقاله\\]/g, postLink);\nconst finalLinkedin = (aiData.linkedin_post || '').replace(/\\[لینک مقاله\\]/g, postLink);\n\nreturn {\n  clean_meta: aiData.meta_description,\n  clean_keywords: aiData.focus_keywords,\n  final_telegram_post: finalTelegram,\n  final_linkedin_post: finalLinkedin\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        592
      ],
      "id": "f33cf54f-c862-47eb-9c80-28b060ffd675",
