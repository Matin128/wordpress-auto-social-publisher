    {
      "parameters": {
        "promptType": "define",
        "text": "=موضوع :{{ $json.body.post.post_title }}\n\n\nمتن :\n{{ $json.body.post.post_content }}",
        "messages": {
          "messageValues": [
            {
              "message": "شما یک دستیار ارشد مارکتینگ و سئو هستید. متن مقاله‌ای که به شما داده می‌شود را تحلیل کنید و خروجی را دقیقاً به فرمت JSON زیر تولید کنید (هیچ متن اضافی یا توضیح قبل و بعد از JSON ننویسید):\n\n{\n  \"meta_description\": \"متای سئو جذاب حداکثر ۱۵۰ کاراکتر شامل کلمات کلیدی اصلی\",\n  \"focus_keywords\": \"کلمه کلیدی اصلی، کلمه کلیدی فرعی ۱، کلمه کلیدی فرعی ۲\",\n  \"telegram_post\": \"متن جذاب و روان برای کانال تلگرام به همراه ایموجی‌های مناسب و هشتگ‌ها و لحن صمیمی\",\n  \"linkedin_post\": \"متن حرفه‌ای و تخصصی برای لینکدین با لحن بیزینسی، ساختار تمیز، هشتگ‌های تخصصی و دعوت به اقدام (CTA)\"\n}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -1040,
        592
      ],
      "id": "e7dca7f4-760c-44c9-840d-6e6829053bd1",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
